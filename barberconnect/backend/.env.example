# ============================
# BASE DE DATOS
# ============================
DATABASE_URL=postgresql://usuario:password@host:5432/barberconnect

# ============================
# AUTENTICACION
# ============================
JWT_SECRET=cambia_este_secreto_por_uno_muy_largo_y_seguro_123456
JWT_EXPIRES_IN=7d

# ============================
# SERVIDOR
# ============================
PORT=5000
NODE_ENV=development

# ============================
# URLs (IMPORTANTE para keep-alive y links en WA)
# ============================
FRONTEND_URL=http://localhost:5173
BACKEND_URL=https://barberconnect-api.onrender.com   # <-- tu URL de Render

# ============================
# WHATSAPP CLOUD API (Meta)
# ============================
WHATSAPP_TOKEN=EAAxxxxx...
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=mi_token_secreto_webhook_123

# ============================
# CLOUDINARY (subir fotos)
# ============================
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ============================
# ADMIN POR DEFECTO
# ============================
ADMIN_EMAIL=admin@barberconnect.com
ADMIN_PASSWORD=Admin123!
