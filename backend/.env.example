# ============================
# BASE DE DATOS
# ============================
DATABASE_URL=postgresql://usuario:password@host:5432/barberconnect

# ============================
# AUTENTICACIÓN
# ============================
JWT_SECRET=cambia_este_secreto_por_uno_muy_largo_y_seguro_123456
JWT_EXPIRES_IN=7d

# ============================
# SERVIDOR
# ============================
PORT=5000
NODE_ENV=development

# ============================
# FRONTEND URL (para links en mensajes WhatsApp)
# ============================
FRONTEND_URL=http://localhost:5173

# ============================
# WHATSAPP CLOUD API (Meta)
# Obtener en: developers.facebook.com
# ============================
WHATSAPP_TOKEN=EAAxxxxx...
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=mi_token_secreto_webhook_123

# ============================
# CLOUDINARY (para subir fotos)
# Obtener en: cloudinary.com (cuenta gratis)
# ============================
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ============================
# ADMIN POR DEFECTO
# (Se crea automáticamente al migrar)
# ============================
ADMIN_EMAIL=admin@barberconnect.com
ADMIN_PASSWORD=Admin123!
